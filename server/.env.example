# ========================================================
# Stylito Fashion Backend Configuration
# ========================================================

PORT=5000
NODE_ENV=development
JWT_SECRET=stylito_super_secure_jwt_secret_key_2026_fashion_hub
SESSION_SECRET=stylito_session_secret_2026

# --------------------------------------------------------
# 1. Google OAuth 2.0 (Google Identity Services)
# https://console.cloud.google.com/apis/credentials
# --------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --------------------------------------------------------
# 2. Real SMS Providers (Configure any ONE provider for live SMS OTP)
# --------------------------------------------------------

# Provider B: Twilio Verify / Twilio SMS - https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Provider C: MSG91 - https://msg91.com
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --------------------------------------------------------
# 3. Real Web Push & Mobile Browser Notifications (VAPID)
# https://tools.reactpwa.com/vapid
# --------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@stylito.com
